# ShubhTithi configuration. Copy to `.env` and edit as needed.
# All variables are prefixed SHUBHTITHI_.

# SQLite cache database file.
SHUBHTITHI_DB_PATH=data/panchang_cache.db

# Bundled trimmed Countries-States-Cities dataset (seeded on first run).
SHUBHTITHI_CITIES_SEED_PATH=data/geo/cities.min.json

# Optional: directory with Swiss Ephemeris data files (sepl_*.se1, semo_*.se1).
# When unset, the built-in Moshier model is used (few arc-second accuracy).
# See README "Ephemeris precision" for download instructions.
# SHUBHTITHI_EPHEMERIS_PATH=data/ephe

# Cache horizon (months) computed on first request and each lazy extension.
SHUBHTITHI_DEFAULT_CACHE_MONTHS=15

# Hard cap on /v1/panchang/range span (days); larger requests get a 422.
SHUBHTITHI_MAX_RANGE_DAYS=400

# Sunrise/sunset convention (default matches published almanacs):
#   upper limb + atmospheric refraction ("apparent" sunrise).
SHUBHTITHI_SUNRISE_UPPER_LIMB=true
SHUBHTITHI_SUNRISE_REFRACTION=true
